# Salin ke .env untuk menjalankan agent secara lokal. Di GitHub Actions, isi sebagai Secrets.

# Token bot (GitHub App installation token atau fine-grained PAT) dengan izin
# Issues & Pull requests: Read/Write dan Contents: Read/Write di repo target.
GH_TOKEN=

# Repo yang dikerjakan agent, format owner/name
TARGET_REPO=damarmustikoaji/mustard-apple

# Provider LLM, dicoba berurutan sampai ada yang berhasil (gemini,github,groq)
LLM_PROVIDERS=gemini,github,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GitHub Models: token dengan izin models:read (di Actions cukup GITHUB_TOKEN + permissions: models: read)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Neon Postgres, hanya untuk tabel error_events (dibaca agent monitor)
DATABASE_URL=
