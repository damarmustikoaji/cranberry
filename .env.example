# Salin ke .env untuk menjalankan agent secara lokal. Di GitHub Actions, isi sebagai Secrets.

# Token bot (GitHub App installation token atau fine-grained PAT) dengan izin
# Issues & Pull requests: Read/Write dan Contents: Read/Write di repo target.
GH_TOKEN=

# Repo yang dikerjakan agent, format owner/name
TARGET_REPO=damarmustikoaji/mustard-apple

# Provider LLM, dicoba berurutan sampai ada yang berhasil.
# "github" (GitHub Models) sengaja tidak dimasukkan: layanan ini sudah dipensiunkan
# total oleh GitHub per 30 Juli 2026, API-nya selalu balas "OK" untuk request apa pun.
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GitHub Models: sudah tidak berfungsi (lihat catatan di atas), disisakan untuk jaga-jaga
# kalau GitHub menghidupkannya lagi di masa depan dengan endpoint yang sama.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Neon Postgres, hanya untuk tabel error_events (dibaca agent monitor)
DATABASE_URL=
